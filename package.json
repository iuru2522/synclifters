  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "vitest run --exclude tests/firestore.rules.test.ts",
    "test:rules": "firebase emulators:exec --only firestore --project demo-synclifters \"pnpm exec vitest run tests/firestore.rules.test.ts\"",
    "test:all": "pnpm test && pnpm test:rules",
    "seed:catalog": "node ./scripts/seed-exercise-catalog.mjs",
    "apk:debug": "cd android && .\\gradlew.bat assembleDebug && cd ..",
    "apk:release": "cd android && .\\gradlew.bat assembleRelease && cd .."
  },
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@firebase/util",
      "protobufjs"
    ],
    "overrides": {
      "@expo/log-box": "57.0.4"
    }
  }
