rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userDocKeys() {
      return [
        'firstName',
        'lastName',
        'email',
        'createdAt',
        'gender',
        'weight',
        'weightUnit',
        'age',
        'height',
        'birthday',
        'firstWeekDay',
        'sportsExperience',
        'onboardingComplete',
        'photoUrl',
        'stats'
      ];
    }

    function userUpdatableKeys() {
      return [
        'firstName',
        'lastName',
        'email',
        'gender',
        'weight',
        'weightUnit',
        'age',
        'height',
        'birthday',
        'firstWeekDay',
        'sportsExperience',
        'onboardingComplete',
        'photoUrl',
        'stats'
      ];
    }

    match /users/{userId} {
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll([
          'firstName',
          'lastName',
          'email',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly(userDocKeys());

      allow read: if isOwner(userId);

      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(userUpdatableKeys())
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if false;

      match /programs/{programId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /exercises/{exerciseId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /bodyMetrics/{entryId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasAll(['type', 'value', 'recordedAt'])
          && request.resource.data.type in ['weight', 'height'];
        allow update: if false;
        allow delete: if isOwner(userId);
      }

      match /activity/{dayId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /sessions/{sessionId} {
        allow read, create, update, delete: if isOwner(userId);
      }
    }

    match /supportTickets/{ticketId} {
      allow read: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasAll([
          'ownerId',
          'email',
          'description',
          'createdAt',
          'status'
        ])
        && request.resource.data.keys().hasOnly([
          'ownerId',
          'email',
          'description',
          'createdAt',
          'status'
        ])
        && request.resource.data.status == 'open';
      allow update, delete: if false;
    }
  }
}
